# Orbit server/API URL. Defaults to this value when unset.
ORBIT_URL=http://127.0.0.1:7700

# Operator or worker credential. Set the appropriate token per shell.
ORBIT_TOKEN=replace-with-a-random-token

# PostgreSQL used by the Orbit server.
DATABASE_URL=postgres://orbit:orbit-local-test@127.0.0.1:55439/orbit

# PostgreSQL used by ignored integration tests.
ORBIT_TEST_DATABASE_URL=postgres://orbit:orbit-local-test@127.0.0.1:55439/orbit

# Optional directory for integration-test evidence.
ORBIT_EVIDENCE_DIR=target/qualification
