ORBIT_URL=http://127.0.0.1:7700
ORBIT_CAPABILITY=container.run
ORBIT_CONTAINER_RUNTIME=podman
ORBIT_WORKSPACES=/var/lib/orbit-worker/compute
# Rootless Podman requires an initialized image store, subuid/subgid mappings,
# cgroup v2 and a valid runtime directory for this dedicated worker user.
# For a user systemd unit prefer the documented rootless installation.
